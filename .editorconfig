root = true

# Escopo de regra de analisador. As severidades globais e o tier de migracao
# (warn -> error) vivem no Directory.Build.props; aqui fica so o que precisa de
# escopo por caminho, que MSBuild nao expressa.

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[tests/**/*.cs]
# CA1707 (identificador nao deve conter underscore) DESLIGADA em testes — decisao
# de escopo, nao divida a pagar.
#
# Medido em 2026-09-11: 604 das 694 ocorrencias da solucao inteira, todas aqui,
# ZERO em src/. Nome de teste no padrao `Metodo_Deve_X_Quando_Y` e idiomatico em
# xUnit e e o que o .claude/agents/test-engineer.md exige ("nome do teste descreve
# o comportamento e a condicao"). "Corrigir" isso destruiria legibilidade para
# satisfazer uma regra escrita para API publica.
#
# Por isso ela nao entra no WarningsNotAsErrors: nao ha contagem a zerar. Em src/
# a regra continua valendo, e la ela ja esta em zero — ou seja, bloqueia.
dotnet_diagnostic.CA1707.severity = none

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
insert_final_newline = true

[*.{ts,tsx,js,jsx,mjs,css}]
indent_style = space
indent_size = 2
insert_final_newline = true
