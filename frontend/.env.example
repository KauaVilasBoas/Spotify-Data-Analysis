# Origem da API, sem barra final.
# Deixe vazio (ou omita) para usar mesma origem — útil quando o Caddy serve
# front e API no mesmo domínio e o bundle é servido via proxy reverso.
# Exemplos válidos:
#   http://localhost:5140          (dev local)
#   https://api.meudominio.com     (deploy externo)
#   /api                           (caminho relativo via proxy)
VITE_API_BASE_URL=http://localhost:5140

# Corte de tempo por requisição em ms (padrão: 20000).
# Hospedagem gratuita acorda devagar — aumente se necessário.
VITE_API_TIMEOUT_MS=20000
