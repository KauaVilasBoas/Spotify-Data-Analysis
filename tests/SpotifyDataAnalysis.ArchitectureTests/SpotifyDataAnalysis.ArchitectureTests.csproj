<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- References to every assembly under test — ArchUnitNET needs them to load the types.
         Module projects are added here as each bounded context is created. -->
    <ProjectReference Include="..\..\src\Shared\SpotifyDataAnalysis.SharedKernel\SpotifyDataAnalysis.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Shared\SpotifyDataAnalysis.Infrastructure\SpotifyDataAnalysis.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Jobs\SpotifyDataAnalysis.Jobs\SpotifyDataAnalysis.Jobs.csproj" />
    <!-- Host: analisado para provar a fronteira Host !-> Domain dos módulos (E0.1). -->
    <ProjectReference Include="..\..\src\Host\SpotifyDataAnalysis.Api\SpotifyDataAnalysis.Api.csproj" />
    <!-- Catalog (E0): os 4 projetos do módulo, para as regras de isolamento avaliarem tipos reais. -->
    <ProjectReference Include="..\..\src\Modules\Catalog\SpotifyDataAnalysis.Modules.Catalog.Domain\SpotifyDataAnalysis.Modules.Catalog.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\SpotifyDataAnalysis.Modules.Catalog.Contracts\SpotifyDataAnalysis.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\SpotifyDataAnalysis.Modules.Catalog.Application\SpotifyDataAnalysis.Modules.Catalog.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\SpotifyDataAnalysis.Modules.Catalog.Infrastructure\SpotifyDataAnalysis.Modules.Catalog.Infrastructure.csproj" />
    <!-- Analytics (E2): os 4 projetos do módulo, para as regras de isolamento avaliarem tipos reais. -->
    <ProjectReference Include="..\..\src\Modules\Analytics\SpotifyDataAnalysis.Modules.Analytics.Domain\SpotifyDataAnalysis.Modules.Analytics.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Analytics\SpotifyDataAnalysis.Modules.Analytics.Contracts\SpotifyDataAnalysis.Modules.Analytics.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Analytics\SpotifyDataAnalysis.Modules.Analytics.Application\SpotifyDataAnalysis.Modules.Analytics.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Analytics\SpotifyDataAnalysis.Modules.Analytics.Infrastructure\SpotifyDataAnalysis.Modules.Analytics.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
