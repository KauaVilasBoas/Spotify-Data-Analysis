{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "PostgreSQL"
  },

  "ConnectionStrings": {
    "SpotifyDb": ""
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Jobs": {
    "OutboxDispatcher": {
      "Interval": "00:00:05",
      "BatchSize": 50,
      "MaxAttempts": 5
    }
  }
}
