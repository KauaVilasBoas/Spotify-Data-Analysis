{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "PostgreSQL"
  },

  "ConnectionStrings": {
    "SpotifyDb": ""
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "ForwardHost": false,
    "TrustAllProxies": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "Jobs": {
    "OutboxDispatcher": {
      "Interval": "00:00:05",
      "BatchSize": 50,
      "MaxAttempts": 5
    },
    "PlaylistIngestion": {
      "Enabled": false,
      "Interval": "06:00:00",
      "SeedPlaylistIds": []
    },
    "CatalogEnrichment": {
      "Enabled": false,
      "Interval": "01:00:00",
      "BatchSize": 200
    }
  },

  "Spotify": {
    "BaseUrl": "https://api.spotify.com/v1/",
    "AuthUrl": "https://accounts.spotify.com/api/token",
    "ClientId": "",
    "ClientSecret": ""
  },

  "Prediction": {
    "TrainingDataset": {
      "Seed": 20260730,
      "TestFraction": 0.2,
      "ReadBatchSize": 5000
    }
  }
}
