<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Infrastructure: composition root do módulo Prediction. Hospeda o PredictionModule (IModule) e os
    adaptadores de tecnologia. Depende para DENTRO: Application (casos de uso) e a Infrastructure
    compartilhada (IModule, DI, DbConnectionFactory).

    É o ÚNICO projeto do módulo que conhece o ML.NET: o framework de ML é um serviço externo, fica atrás da
    porta ITrainingDatasetProvider e nunca alcança Application ou Domain.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SpotifyDataAnalysis.Modules.Prediction.Application\SpotifyDataAnalysis.Modules.Prediction.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\SpotifyDataAnalysis.Infrastructure\SpotifyDataAnalysis.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpotifyDataAnalysis.Modules.Prediction.Tests" />
  </ItemGroup>

</Project>
